classDiagram
    class AuthController {
        +register(RegisterRequest)
        +login(LoginRequest)
        +refreshToken(Map)
    }
    class UserController {
        +getCurrentUser()
        +updateCurrentUser(User)
        +getUserSetting()
        +updateUserSetting(UserSetting)
        +getLeaderboard(int)
    }
    class TaskController {
        +getTasks(TaskRecommendationQuery)
        +createTask(TaskCreateRequest)
        +getTaskById(Long)
        +acceptTask(Long)
        +unacceptTask(Long)
        +completeTask(Long)
        +cancelTask(Long)
        +likeTask(Long)
        +unlikeTask(Long)
        +favoriteTask(Long)
        +unfavoriteTask(Long)
    }
    class TaskCommentController {
        +getComments(Long)
        +createComment(Long, TaskCommentCreateRequest)
        +likeComment(Long)
        +unlikeComment(Long)
    }
    class TaskReviewController {
        +createReview(Long, TaskReviewCreateRequest)
        +getTaskReviews(Long)
    }
    class TaskReviewBatchController {
        +getTaskReviewCounts(String)
    }
    class MessageController {
        +getMessages()
        +sendMessage(MessageRequest)
        +markRead(Long)
    }
    class NotificationController {
        +getNotifications()
        +getUnreadCount()
        +markAsRead(Long)
        +markAllRead()
    }
    class SearchController {
        +search(String, String, int, int)
    }
    class FileController {
        +uploadFile(MultipartFile)
        +serveFile(String)
    }
    class VerificationController {
        +submitVerification(List, String, String)
        +getMyVerification()
        +getVerificationImage(String)
    }
    class FeedbackController {
        +createFeedback(FeedbackCreateRequest)
        +getMyFeedback()
    }
    class AdminController {
        +getDashboard()
        +getUsers()
        +updateUserStatus(Long, AdminUserStatusUpdateRequest)
        +reviewTask(Long, AdminTaskReviewRequest)
        +updateFeedback(Long, AdminFeedbackUpdateRequest)
        +reviewVerification(Long, AdminVerificationReviewRequest)
        +batchReviewTasks(Map)
    }

    class AuthService
    class UserService
    class TaskService
    class TaskCommentService
    class TaskReviewService
    class MessageService
    class NotificationService
    class VerificationService
    class FeedbackService
    class AdminService
    class AnnouncementService
    class TaskMapper

    class User {
        +id: Long
        +studentId: String
        +name: String
        +email: String
        +password: String
        +role: String
        +status: String
        +verifiedStatus: String
        +score: Decimal
        +points: Integer
    }
    class UserSetting {
        +id: Long
        +userId: Long
        +notificationEnabled: Boolean
        +theme: String
        +language: String
    }
    class UserVerification {
        +id: Long
        +userId: Long
        +type: String
        +realName: String
        +studentId: String
        +imageUrls: String
        +status: String
    }
    class Task {
        +id: Long
        +requesterId: Long
        +title: String
        +description: String
        +category: String
        +taskMode: String
        +contactInfo: String
        +imageUrls: String
        +reviewStatus: String
        +status: String
        +likeCount: Integer
        +expiresAt: DateTime
    }
    class TaskParticipant {
        +id: Long
        +taskId: Long
        +participantId: Long
        +role: String
        +status: String
    }
    class TaskComment {
        +id: Long
        +taskId: Long
        +authorId: Long
        +parentId: Long
        +content: String
        +likeCount: Integer
    }
    class TaskLike {
        +id: Long
        +taskId: Long
        +userId: Long
    }
    class TaskFavorite {
        +id: Long
        +userId: Long
        +taskId: Long
    }
    class TaskReview {
        +id: Long
        +taskId: Long
        +reviewerId: Long
        +revieweeId: Long
        +reviewerRole: String
        +rating: Integer
        +content: String
    }
    class Message {
        +id: Long
