    User "1" --> "1" UserSetting : owns
    User "1" --> "0..*" UserVerification : applies
    User "1" --> "0..*" Task : publishes
    User "1" --> "0..*" Notification : receives
    User "1" --> "0..*" Feedback : submits
    Task "1" --> "0..*" TaskParticipant : contains
    Task "1" --> "0..*" TaskComment : contains
    Task "1" --> "0..*" TaskLike : contains
    Task "1" --> "0..*" TaskFavorite : bookmarked
    Task "1" --> "0..*" TaskReview : contains
    Task "1" --> "0..*" Message : context
