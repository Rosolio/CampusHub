<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campushub.mapper.TaskParticipantMapper">
    <resultMap id="TaskParticipantResultMap" type="com.campushub.entity.TaskParticipant">
        <id property="id" column="id"/>
        <result property="taskId" column="task_id"/>
        <result property="participantId" column="participant_id"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectById" resultMap="TaskParticipantResultMap">
        SELECT * FROM task_participants WHERE id = #{id}
    </select>

    <select id="selectByTaskId" resultMap="TaskParticipantResultMap">
        SELECT * FROM task_participants WHERE task_id = #{taskId}
    </select>

    <select id="selectByParticipantId" resultMap="TaskParticipantResultMap">
        SELECT * FROM task_participants WHERE participant_id = #{participantId}
    </select>

    <select id="selectByTaskIdAndRole" resultMap="TaskParticipantResultMap">
        SELECT * FROM task_participants WHERE task_id = #{taskId} AND role = #{role}
    </select>

    <select id="selectByTaskIdAndParticipantIdAndRole" resultMap="TaskParticipantResultMap">
        SELECT *
        FROM task_participants
        WHERE task_id = #{taskId}
          AND participant_id = #{participantId}
          AND role = #{role}
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.campushub.entity.TaskParticipant" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO task_participants (task_id, participant_id, role, status, created_at, updated_at)
        VALUES (#{taskId}, #{participantId}, #{role}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.campushub.entity.TaskParticipant">
        UPDATE task_participants
        SET task_id = #{taskId}, participant_id = #{participantId}, role = #{role}, 
            status = #{status}, updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM task_participants WHERE id = #{id}
    </delete>

    <delete id="deleteByTaskId" parameterType="java.lang.Long">
        DELETE FROM task_participants WHERE task_id = #{taskId}
    </delete>
</mapper>
